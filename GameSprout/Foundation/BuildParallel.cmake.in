# Generated by ParallelBuild.cmake. Optional: -DCONFIG=Release -DTARGET=name
cmake_minimum_required(VERSION 3.16)
cmake_host_system_information(RESULT build_cores QUERY NUMBER_OF_LOGICAL_CORES)
if(NOT build_cores MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "Cannot determine the host CPU core count.")
endif()
set(build_arguments --build "@CMAKE_BINARY_DIR@" --parallel "${build_cores}")
if(DEFINED CONFIG AND NOT "${CONFIG}" STREQUAL "")
    list(APPEND build_arguments --config "${CONFIG}")
endif()
if(DEFINED TARGET AND NOT "${TARGET}" STREQUAL "")
    list(APPEND build_arguments --target "${TARGET}")
endif()
execute_process(COMMAND "@CMAKE_COMMAND@" ${build_arguments}
    RESULT_VARIABLE build_result)
if(NOT build_result STREQUAL "0")
    message(FATAL_ERROR "Parallel build failed: ${build_result}")
endif()
