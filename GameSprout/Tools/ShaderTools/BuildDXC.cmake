cmake_minimum_required(VERSION 3.24)
# SDL_shadercross's pinned DXC fork and matching dependencies. Independent build.
get_filename_component(repository_root "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(deps "${repository_root}/Bin/Deps")
function(ShaderSource name repository revision hash destination)
    set(stamp "${destination}/.gamesprout-revision")
    if(EXISTS "${stamp}")
        file(READ "${stamp}" current)
        if(current STREQUAL revision)
            return()
        endif()
        message(FATAL_ERROR "Different DXC source revision exists at ${destination}; choose a clean source directory")
    endif()
    if(EXISTS "${destination}/CMakeLists.txt")
        message(FATAL_ERROR "Unregistered source directory: ${destination}")
    endif()
    file(MAKE_DIRECTORY "${deps}/ShaderSourceCache")
    set(archive "${deps}/ShaderSourceCache/${name}-${revision}.tar.gz")
    file(DOWNLOAD "https://codeload.github.com/${repository}/tar.gz/${revision}" "${archive}" EXPECTED_HASH "SHA256=${hash}" TLS_VERIFY ON SHOW_PROGRESS)
    set(extract "${deps}/ShaderSourceCache/${name}-${revision}")
    file(MAKE_DIRECTORY "${extract}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extract}")
    file(GLOB roots LIST_DIRECTORIES true "${extract}/*")
    list(LENGTH roots count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Unexpected DXC source archive structure")
    endif()
    list(GET roots 0 root)
    get_filename_component(parent "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(RENAME "${root}" "${destination}")
    file(WRITE "${stamp}" "${revision}")
endfunction()
set(source "${deps}/DXC-SDL-src")
ShaderSource(DXC libsdl-org/DirectXShaderCompiler 2c84a1c5ab7091608c97df6ba5ccf46e71c322eb aaabe9adc8bd15aab887b122537d79bd9544b64934ca6f44c83e15c4b1d81549 "${source}")
ShaderSource(SPIRV-Headers KhronosGroup/SPIRV-Headers ad9184e76a66b1001c29db9b0a3e87f646c64de0 b5b7eba62453eb8c6f6a5fbf7155b71cde693bafe9cd5f03b79ed8c714816afe "${source}/external/SPIRV-Headers")
ShaderSource(SPIRV-Tools KhronosGroup/SPIRV-Tools 0539c81f69a3daeb706fd3477dca61435b475156 fb48ad981129d939863d5d46c8a5b3b70577bc95665b4c1afb0f14a090b50d53 "${source}/external/SPIRV-Tools")
ShaderSource(DirectX-Headers microsoft/DirectX-Headers 980971e835876dc0cde415e8f9bc646e64667bf7 b5a4b6d8806ff7f29f19879f83d015dbe8740676d4ca0b48647a789cc7773c4e "${source}/external/DirectX-Headers")
set(build "${deps}/DXC-SDL-build")
set(generator)
find_program(ninja NAMES ninja HINTS "$ENV{HOME}/Qt/Tools/Ninja")
if(ninja AND NOT EXISTS "${build}/CMakeCache.txt")
    set(generator -G Ninja "-DCMAKE_MAKE_PROGRAM=${ninja}")
endif()
if(CMAKE_HOST_APPLE)
    set(rpath "@loader_path/../lib")
else()
    set(rpath "$ORIGIN/../lib")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${build}" ${generator}
    -C "${source}/cmake/caches/PredefinedParams.cmake" -DCMAKE_BUILD_TYPE=Release
    -DHLSL_ENABLE_DEBUG_ITERATORS=ON -DHLSL_INCLUDE_TESTS=OFF -DLLVM_INCLUDE_TESTS=OFF -DSPIRV_BUILD_TESTS=OFF
    -DHLSL_DISABLE_SOURCE_GENERATION=ON -DLLVM_ENABLE_ASSERTIONS=OFF -DLLVM_PARALLEL_LINK_JOBS=1
    -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON "-DCMAKE_INSTALL_RPATH=${rpath}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "DXC configuration failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --config Release --target dxc dxildll --parallel 6 RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "DXC build failed")
endif()
message(STATUS "DXC SDK ready: ${build}")
