string(TOLOWER "${CMAKE_HOST_SYSTEM_PROCESSOR}" shader_host_arch)
if(shader_host_arch MATCHES "^(arm64|aarch64)$")
    set(shader_host_arch arm64)
elseif(shader_host_arch MATCHES "^(amd64|x86_64|x64)$")
    set(shader_host_arch x64)
else()
    message(FATAL_ERROR "Unsupported DXC host architecture")
endif()
set(GAMESPROUT_DXC_ROOT "" CACHE PATH "DXC SDK, including bin/dxc and lib/dxcompiler")
if(GAMESPROUT_DXC_ROOT)
    set(dxc_root "${GAMESPROUT_DXC_ROOT}")
elseif(WIN32)
    FetchContent_Declare(dxc_sdk
        URL "https://github.com/microsoft/DirectXShaderCompiler/releases/download/v1.9.2602/dxc_2026_02_20.zip"
        URL_HASH SHA256=a1e89031421cf3c1fca6627766ab3020ca4f962ac7e2caa7fab2b33a8436151e)
    FetchContent_MakeAvailable(dxc_sdk)
    set(dxc_root "${dxc_sdk_SOURCE_DIR}")
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND shader_host_arch STREQUAL "x64")
    FetchContent_Declare(dxc_sdk
        URL "https://github.com/microsoft/DirectXShaderCompiler/releases/download/v1.9.2602/linux_dxc_2026_02_20.x86_64.tar.gz"
        URL_HASH SHA256=a1d3e3b5e1c5685b3eb27d5e8890e41d87df45def05112a2d6f1a63a931f7d60)
    FetchContent_MakeAvailable(dxc_sdk)
    set(dxc_root "${dxc_sdk_SOURCE_DIR}")
else()
    set(dxc_root "${repository_root}/Bin/Deps/DXC-SDL-build")
endif()
if(WIN32)
    if(EXISTS "${dxc_root}/bin/${shader_host_arch}/dxc.exe")
        set(dxc_bin "${dxc_root}/bin/${shader_host_arch}")
        set(dxc_lib "${dxc_root}/lib/${shader_host_arch}")
    else()
        set(dxc_bin "${dxc_root}/bin")
        set(dxc_lib "${dxc_root}/lib")
    endif()
    set(dxc_cli "${dxc_bin}/dxc.exe")
    set(dxc_library "${dxc_bin}/dxcompiler.dll")
    file(GLOB dxc_runtime "${dxc_bin}/dxcompiler.dll" "${dxc_bin}/dxil.dll")
else()
    set(dxc_bin "${dxc_root}/bin")
    set(dxc_lib "${dxc_root}/lib")
    set(dxc_cli "${dxc_bin}/dxc")
    if(APPLE)
        set(dxc_library "${dxc_lib}/libdxcompiler.dylib")
        file(GLOB dxc_runtime "${dxc_lib}/libdxcompiler*.dylib" "${dxc_lib}/libdxil*.dylib")
    else()
        set(dxc_library "${dxc_lib}/libdxcompiler.so")
        file(GLOB dxc_runtime "${dxc_lib}/libdxcompiler.so*" "${dxc_lib}/libdxil.so*")
    endif()
endif()
if(NOT EXISTS "${dxc_cli}" OR NOT EXISTS "${dxc_library}")
    message(FATAL_ERROR "DXC is required. Run cmake -P GameSprout/Tools/ShaderTools/BuildDXC.cmake first, or set GAMESPROUT_DXC_ROOT.")
endif()
add_library(GameSproutDXC SHARED IMPORTED GLOBAL)
set_target_properties(GameSproutDXC PROPERTIES IMPORTED_LOCATION "${dxc_library}")
if(WIN32)
    set_target_properties(GameSproutDXC PROPERTIES IMPORTED_IMPLIB "${dxc_lib}/dxcompiler.lib")
    install(FILES ${dxc_runtime} DESTINATION bin)
else()
    install(FILES ${dxc_runtime} DESTINATION lib)
endif()
get_filename_component(dxc_cli_real "${dxc_cli}" REALPATH)
install(PROGRAMS "${dxc_cli_real}" DESTINATION bin RENAME "dxc${CMAKE_EXECUTABLE_SUFFIX}")
foreach(license IN ITEMS "${dxc_root}/LICENSE-LLVM.txt" "${dxc_root}/LICENSE-MS.txt" "${repository_root}/Bin/Deps/DXC-SDL-src/LICENSE.TXT")
    if(EXISTS "${license}")
        install(FILES "${license}" DESTINATION Licenses/DXC)
    endif()
endforeach()
file(SHA256 "${dxc_cli_real}" dxc_identity)
file(SHA256 "${dxc_library}" dxc_library_identity)
