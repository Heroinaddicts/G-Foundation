    <item><widget class="QDoubleSpinBox" name="clipSeekSpin"><property name="maximumSize"><size><width>90</width><height>24</height></size></property><property name="maximum"><double>86400</double></property><property name="decimals"><number>3</number></property><property name="suffix"><string> s</string></property><property name="keyboardTracking"><bool>false</bool></property><property name="toolTip"><string>输入预览时间，回车或离开输入框后定位。</string></property><property name="accessibleName"><string>预览时间</string></property></widget></item>
    <item><widget class="QPushButton" name="clipSeekButton"><property name="text"><string>↵</string></property><property name="maximumSize"><size><width>24</width><height>24</height></size></property><property name="toolTip"><string>定位到输入的时间</string></property><property name="accessibleName"><string>定位时间</string></property></widget></item>
