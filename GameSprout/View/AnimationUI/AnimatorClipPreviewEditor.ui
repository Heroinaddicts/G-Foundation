<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AnimatorClipPreviewEditorForm</class>
 <widget class="QWidget" name="AnimatorClipPreviewEditorForm">
  <property name="acceptDrops"><bool>true</bool></property>
  <property name="toolTip"><string>单独预览动画，不运行 Controller。可切换同源动画，或拖入其他 Clip；还原恢复编辑姿态。</string></property>
  <property name="styleSheet"><string>QWidget#directClipResource { background:#1d1f23; border:1px solid #454a53; border-radius:3px; }
QComboBox#relatedClipCombo { border:0; background:transparent; padding:1px 4px; }
QToolButton#browseClipButton,QToolButton#clipActionsButton { border:0; background:transparent; padding:2px; }
QToolButton#browseClipButton:hover,QToolButton#clipActionsButton:hover { background:#3b414b; }
QLabel#clipErrorLabel { color:#ffb4ae; background:#3b2c2d; padding:4px; }
QLabel#clipPlaybackLabel { color:#aeb8c5; }
QToolButton#clipActionsButton::menu-indicator { image:none; width:0px; }
QMenu#clipReferenceMenu { background:#282c32; color:#e0e2e6; border:1px solid #566171; padding:4px 0; }
QMenu#clipReferenceMenu::item { padding:5px 16px; }
QMenu#clipReferenceMenu::item:selected { background:#3a526d; color:#ffffff; }
QMenu#clipReferenceMenu::item:disabled { color:#89919c; }
QSlider#clipTimeSlider::groove:horizontal { height:4px; background:#424852; border-radius:2px; }
QSlider#clipTimeSlider::sub-page:horizontal { background:#6194c4; border-radius:2px; }
QSlider#clipTimeSlider::handle:horizontal { width:10px; margin:-4px 0; background:#c5d8eb; border-radius:4px; }</string></property>
  <layout class="QVBoxLayout" name="previewLayout">
   <property name="spacing"><number>4</number></property>
   <property name="leftMargin"><number>0</number></property><property name="topMargin"><number>0</number></property><property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property>
   <item><layout class="QFormLayout" name="clipSettingsLayout">
    <property name="fieldGrowthPolicy"><enum>QFormLayout::AllNonFixedFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignLeft|Qt::AlignVCenter</set></property><property name="horizontalSpacing"><number>8</number></property>
    <item row="0" column="0"><widget class="QLabel" name="directClipLabel"><property name="text"><string>动画</string></property><property name="minimumSize"><size><width>80</width><height>0</height></size></property><property name="maximumSize"><size><width>80</width><height>16777215</height></size></property></widget></item>
    <item row="0" column="1"><widget class="QWidget" name="directClipResource"><property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Fixed"><horstretch>1</horstretch><verstretch>0</verstretch></sizepolicy></property><property name="minimumSize"><size><width>0</width><height>24</height></size></property><property name="maximumSize"><size><width>16777215</width><height>24</height></size></property>
     <layout class="QHBoxLayout" name="clipReferenceLayout" stretch="1,0,0"><property name="spacing"><number>0</number></property><property name="leftMargin"><number>0</number></property><property name="topMargin"><number>0</number></property><property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property>
      <item><widget class="QComboBox" name="relatedClipCombo"><property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Fixed"><horstretch>1</horstretch><verstretch>0</verstretch></sizepolicy></property><property name="minimumSize"><size><width>0</width><height>22</height></size></property><property name="sizeAdjustPolicy"><enum>QComboBox::AdjustToMinimumContentsLengthWithIcon</enum></property><property name="minimumContentsLength"><number>1</number></property><property name="placeholderText"><string>选择或拖入动画…</string></property><property name="accessibleName"><string>预览动画</string></property></widget></item>
      <item><widget class="QToolButton" name="browseClipButton"><property name="focusPolicy"><enum>Qt::StrongFocus</enum></property><property name="minimumSize"><size><width>22</width><height>22</height></size></property><property name="maximumSize"><size><width>22</width><height>22</height></size></property><property name="icon"><iconset resource="ResourceFieldIcons.qrc"><normaloff>:/Inspector/ResourceField/Select.svg</normaloff>:/Inspector/ResourceField/Select.svg</iconset></property><property name="toolTip"><string>选择其他源文件中的动画</string></property><property name="accessibleName"><string>选择预览动画</string></property></widget></item>
      <item><widget class="QToolButton" name="clipActionsButton"><property name="focusPolicy"><enum>Qt::StrongFocus</enum></property><property name="minimumSize"><size><width>22</width><height>22</height></size></property><property name="maximumSize"><size><width>22</width><height>22</height></size></property><property name="icon"><iconset resource="ResourceFieldIcons.qrc"><normaloff>:/Inspector/ResourceField/More.svg</normaloff>:/Inspector/ResourceField/More.svg</iconset></property><property name="popupMode"><enum>QToolButton::InstantPopup</enum></property><property name="toolTip"><string>动画引用操作</string></property><property name="accessibleName"><string>动画引用操作</string></property></widget></item>
