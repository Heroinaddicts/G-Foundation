    <item><widget class="QDoubleSpinBox" name="clipSpeedSpin"><property name="maximumSize"><size><width>76</width><height>24</height></size></property><property name="maximum"><double>100</double></property><property name="decimals"><number>2</number></property><property name="singleStep"><double>0.1</double></property><property name="value"><double>1</double></property><property name="suffix"><string> ×</string></property><property name="keyboardTracking"><bool>false</bool></property><property name="toolTip"><string>仅调整本次预览倍率，不修改 Animator 的速度配置。</string></property><property name="accessibleName"><string>预览倍率</string></property></widget></item>
    <item><widget class="QCheckBox" name="clipLoopCheck"><property name="text"><string>循环</string></property><property name="checked"><bool>true</bool></property><property name="toolTip"><string>循环预览当前动画</string></property></widget></item>
   </layout></item>
