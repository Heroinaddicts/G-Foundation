    <item><widget class="QPushButton" name="clipPlayButton"><property name="text"><string>播放</string></property><property name="toolTip"><string>播放或继续；播放到结尾后重新开始。</string></property><property name="maximumSize"><size><width>44</width><height>24</height></size></property></widget></item>
    <item><widget class="QPushButton" name="clipPauseButton"><property name="text"><string>暂停</string></property><property name="maximumSize"><size><width>44</width><height>24</height></size></property></widget></item>
    <item><widget class="QPushButton" name="clipStopButton"><property name="text"><string>还原</string></property><property name="toolTip"><string>停止预览，恢复编辑姿态。</string></property><property name="maximumSize"><size><width>44</width><height>24</height></size></property></widget></item>
    <item><widget class="QSlider" name="clipTimeSlider"><property name="minimumSize"><size><width>0</width><height>22</height></size></property><property name="maximum"><number>10000</number></property><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="toolTip"><string>拖动定位时间，松开后恢复之前的播放状态。</string></property></widget></item>
   </layout></item>
