  <property name="styleSheet">
   <string notr="true">QMainWindow#ConsoleUIWindow, QWidget#consoleContent, QWidget#detailPanel {
 background-color: #202124; color: #f1f3f5;
}
QToolButton {
 color: #f1f3f5; background-color: #303237; border: 1px solid #484b52;
 border-radius: 3px; padding: 4px 8px;
}
QToolButton:checked { background-color: #34445a; border-color: #8496b0; }
QToolButton:hover { background-color: #3c4047; }
QLineEdit {
 background-color: #191a1d; color: #f1f3f5; border: 1px solid #484b52;
 border-radius: 3px; padding: 4px 6px;
 selection-background-color: #34445a; selection-color: #ffffff;
}
QLabel { color: #cbd0d6; }
QTreeWidget {
 background-color: #202124; alternate-background-color: #26282c;
 color: #f1f3f5; border: none; selection-background-color: #34445a;
}
QTreeWidget::item { padding: 5px 4px; border-bottom: 1px solid #303237; }
QTreeWidget::item:selected { background-color: #34445a; }
QTreeWidget::item:hover:!selected { background-color: #2e3035; }
QHeaderView::section {
 background-color: #303237; color: #dbe0e6; border: none;
 border-bottom: 1px solid #484b52; padding: 5px 4px;
}
QPlainTextEdit {
 background-color: #191a1d; color: #f1f3f5; border: 1px solid #484b52;
 selection-background-color: #34445a; selection-color: #ffffff;
}
QSplitter::handle { background-color: #484b52; }</string>
  </property>
