      <item><widget class="QToolButton" name="followButton"><property name="text"><string>跟随</string></property><property name="checkable"><bool>true</bool></property><property name="checked"><bool>true</bool></property><property name="toolTip"><string>在列表底部时跟随新日志；向上滚动可暂停跟随</string></property></widget></item>
      <item><widget class="QLineEdit" name="searchEdit"><property name="placeholderText"><string>搜索日志…</string></property><property name="clearButtonEnabled"><bool>true</bool></property></widget></item>
