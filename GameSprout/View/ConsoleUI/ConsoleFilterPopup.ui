 <class>ConsoleFilterPopup</class>
 <widget class="QWidget" name="ConsoleFilterPopup">
  <property name="minimumSize"><size><width>190</width><height>0</height></size></property>
  <property name="windowTitle"><string>日志级别</string></property>
  <property name="font"><font><pointsize>11</pointsize></font></property>
  <property name="styleSheet"><string notr="true">QWidget#ConsoleFilterPopup {
 background-color: #26282c; border: 1px solid #5b626c; border-radius: 4px;
}
QCheckBox { spacing: 10px; padding: 7px 8px; border: 1px solid transparent; border-radius: 3px; }
QCheckBox:hover, QCheckBox:focus { background-color: #34445a; border-color: #8496b0; }
QCheckBox::indicator {
 width: 16px; height: 16px; border: 1px solid #8496b0; border-radius: 3px;
 background-color: #191a1d;
}
QCheckBox::indicator:checked { background-color: #34445a; image: url(:/ConsoleUI/check.svg); }
QLabel { color: #cbd0d6; padding: 3px 8px; }</string></property>
  <layout class="QVBoxLayout" name="filterLayout">
