 <class>LightComponentEditorForm</class>
 <widget class="QWidget" name="LightComponentEditorForm">
  <layout class="QFormLayout" name="formLayout">
   <property name="fieldGrowthPolicy"><enum>QFormLayout::AllNonFixedFieldsGrow</enum></property>
   <item row="0" column="0"><widget class="QLabel" name="typeLabel"><property name="text"><string>类型</string></property></widget></item>
   <item row="0" column="1"><widget class="QLabel" name="typeValue"><property name="text"><string>Directional · 方向光</string></property></widget></item>
   <item row="1" column="0"><widget class="QLabel" name="stateLabel"><property name="text"><string>状态</string></property></widget></item>
   <item row="1" column="1"><widget class="QCheckBox" name="enabledCheck"><property name="text"><string>启用光源</string></property></widget></item>
   <item row="2" column="0"><widget class="QLabel" name="colorLabel"><property name="text"><string>颜色</string></property><property name="toolTip"><string>RGB 数值为线性颜色，可大于 1；色块与拾色器按 sRGB 显示。</string></property></widget></item>
   <item row="2" column="1"><layout class="QHBoxLayout" name="colorLayout">
    <item><widget class="QLineEdit" name="redEdit"><property name="sizePolicy"><sizepolicy hsizetype="Ignored" vsizetype="Fixed"><horstretch>1</horstretch><verstretch>0</verstretch></sizepolicy></property><property name="minimumSize"><size><width>32</width><height>0</height></size></property><property name="accessibleName"><string>R（线性）</string></property><property name="placeholderText"><string>R</string></property><property name="toolTip"><string>线性红色分量，可大于 1。拾色器按 sRGB 显示。</string></property></widget></item>
    <item><widget class="QLineEdit" name="greenEdit"><property name="sizePolicy"><sizepolicy hsizetype="Ignored" vsizetype="Fixed"><horstretch>1</horstretch><verstretch>0</verstretch></sizepolicy></property><property name="minimumSize"><size><width>32</width><height>0</height></size></property><property name="accessibleName"><string>G（线性）</string></property><property name="placeholderText"><string>G</string></property></widget></item>
    <item><widget class="QLineEdit" name="blueEdit"><property name="sizePolicy"><sizepolicy hsizetype="Ignored" vsizetype="Fixed"><horstretch>1</horstretch><verstretch>0</verstretch></sizepolicy></property><property name="minimumSize"><size><width>32</width><height>0</height></size></property><property name="accessibleName"><string>B（线性）</string></property><property name="placeholderText"><string>B</string></property></widget></item>
    <item><widget class="QPushButton" name="colorButton"><property name="text"><string/></property><property name="minimumSize"><size><width>36</width><height>0</height></size></property><property name="maximumSize"><size><width>36</width><height>16777215</height></size></property><property name="sizePolicy"><sizepolicy hsizetype="Fixed" vsizetype="Fixed"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property><property name="accessibleName"><string>选择光源颜色</string></property><property name="toolTip"><string>选择颜色；拾色器按 sRGB 显示，保存为线性 RGB。</string></property></widget></item>
   </layout></item>
   <item row="3" column="0"><widget class="QLabel" name="intensityLabel"><property name="text"><string>强度</string></property></widget></item>
   <item row="3" column="1"><widget class="QLineEdit" name="intensityEdit"><property name="toolTip"><string>与 URP 对齐的相对强度，0 关闭照明；通过 Transform 旋转改变照射方向。</string></property></widget></item>
   <item row="4" column="0"><widget class="QLabel" name="maskLabel"><property name="text"><string>影响层</string></property></widget></item>
   <item row="4" column="1"><widget class="LayerMaskCombo" name="maskCombo"><property name="sizePolicy"><sizepolicy hsizetype="Ignored" vsizetype="Fixed"><horstretch>1</horstretch><verstretch>0</verstretch></sizepolicy></property></widget></item>
   <item row="5" column="0" colspan="2"><widget class="QLabel" name="directionHint"><property name="text"><string>沿对象局部 +Z 方向照射；旋转对象调整方向。当前位置不影响方向光。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item row="6" column="0" colspan="2"><widget class="QGroupBox" name="shadowGroup">
    <property name="title"><string>实时阴影</string></property><property name="checkable"><bool>true</bool></property><property name="checked"><bool>false</bool></property>
    <property name="toolTip"><string>开启方向光阴影。当前由最亮且开启阴影的方向光提供主阴影。</string></property>
    <layout class="QFormLayout" name="shadowLayout">
     <property name="fieldGrowthPolicy"><enum>QFormLayout::AllNonFixedFieldsGrow</enum></property>
     <item row="0" column="0"><widget class="QLabel" name="shadowStrengthLabel"><property name="text"><string>强度</string></property></widget></item>
     <item row="0" column="1"><widget class="QLineEdit" name="shadowStrengthEdit"><property name="toolTip"><string>阴影强度，范围 0 到 1。不会使环境漫反射完全变黑。</string></property></widget></item>
     <item row="1" column="0"><widget class="QLabel" name="shadowDistanceLabel"><property name="text"><string>距离（米）</string></property></widget></item>
     <item row="1" column="1"><widget class="QLineEdit" name="shadowDistanceEdit"><property name="toolTip"><string>从当前视口相机计算的最大阴影距离，必须大于 0。较短距离可提高局部阴影精度。</string></property></widget></item>
     <item row="2" column="0"><widget class="QLabel" name="shadowResolutionLabel"><property name="text"><string>图集分辨率</string></property></widget></item>
     <item row="2" column="1"><widget class="QComboBox" name="shadowResolutionCombo">
      <item><property name="text"><string>256</string></property></item><item><property name="text"><string>512</string></property></item><item><property name="text"><string>1024</string></property></item><item><property name="text"><string>2048</string></property></item><item><property name="text"><string>4096</string></property></item>
     </widget></item>
     <item row="3" column="0"><widget class="QLabel" name="shadowCascadesLabel"><property name="text"><string>级联数量</string></property></widget></item>
     <item row="3" column="1"><widget class="QComboBox" name="shadowCascadesCombo"><property name="toolTip"><string>将相机可视范围拆成多级阴影。更多级联提高近处精度，也会增加绘制成本。</string></property>
      <item><property name="text"><string>1</string></property></item><item><property name="text"><string>2</string></property></item><item><property name="text"><string>4</string></property></item>
     </widget></item>
     <item row="4" column="0"><widget class="QLabel" name="shadowDepthBiasLabel"><property name="text"><string>深度偏移</string></property></widget></item>
     <item row="4" column="1"><widget class="QLineEdit" name="shadowDepthBiasEdit"><property name="toolTip"><string>0 到 10 个阴影纹素，按每级联尺寸换算。减轻表面自阴影条纹；过大可能让阴影脱离物体。</string></property></widget></item>
     <item row="5" column="0"><widget class="QLabel" name="shadowNormalBiasLabel"><property name="text"><string>法线偏移</string></property></widget></item>
     <item row="5" column="1"><widget class="QLineEdit" name="shadowNormalBiasEdit"><property name="toolTip"><string>0 到 10 个阴影纹素，沿接收表面法线偏移阴影查询位置。过大可能造成漏光。</string></property></widget></item>
     <item row="6" column="1"><widget class="QCheckBox" name="softShadowsCheck"><property name="text"><string>软阴影</string></property><property name="toolTip"><string>使用邻近深度样本平滑阴影边缘，会增加采样成本。</string></property></widget></item>
     <item row="7" column="1"><widget class="QCheckBox" name="cacheStaticCastersCheck"><property name="text"><string>缓存静态阴影</string></property><property name="toolTip"><string>复用在 Static 菜单标记为 Shadow Caster Static 的物体阴影，其余物体的阴影单独实时更新。</string></property></widget></item>
     <item row="8" column="0" colspan="2"><widget class="QToolButton" name="shadowAdvancedToggle">
      <property name="text"><string>高级选项</string></property>
      <property name="checkable"><bool>true</bool></property>
      <property name="toolButtonStyle"><enum>Qt::ToolButtonTextBesideIcon</enum></property>
      <property name="arrowType"><enum>Qt::RightArrow</enum></property>
      <property name="autoRaise"><bool>true</bool></property>
     </widget></item>
     <item row="9" column="0" colspan="2"><widget class="QWidget" name="shadowAdvancedOptions">
      <property name="visible"><bool>false</bool></property>
      <layout class="QFormLayout" name="shadowAdvancedLayout">
       <property name="fieldGrowthPolicy"><enum>QFormLayout::AllNonFixedFieldsGrow</enum></property>
       <property name="leftMargin"><number>0</number></property><property name="topMargin"><number>0</number></property>
       <property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property>
        <item row="0" column="0"><widget class="QLabel" name="shadowUpdateModeLabel"><property name="text"><string>静态更新</string></property></widget></item>
        <item row="0" column="1"><widget class="QComboBox" name="shadowUpdateModeCombo">
         <property name="toolTip"><string>自动增量更新可复用重叠深度，只补画新露出的部分。整级重绘会在某一级联需要更新时重画该级。</string></property>
         <item><property name="text"><string>自动增量更新</string></property></item>
         <item><property name="text"><string>整级重绘</string></property></item>
        </widget></item>
        <item row="1" column="0"><widget class="QLabel" name="shadowSplitModeLabel"><property name="text"><string>级联分割</string></property></widget></item>
        <item row="1" column="1"><widget class="QComboBox" name="shadowSplitModeCombo">
         <property name="toolTip"><string>自动分配级联距离，或按相机近裁剪面到有效阴影远端的百分比手动分割。</string></property>
         <item><property name="text"><string>自动</string></property></item>
         <item><property name="text"><string>手动</string></property></item>
        </widget></item>
        <item row="2" column="0"><widget class="QLabel" name="shadowSplit1Label"><property name="text"><string>分割 1 (%)</string></property><property name="toolTip"><string>相机近裁剪面到有效阴影远端的百分比。分割须在 0% 到 100% 之间且从近到远严格递增。</string></property></widget></item>
        <item row="2" column="1"><widget class="QLineEdit" name="shadowSplit1Edit"><property name="accessibleName"><string>第一级联结束百分比</string></property></widget></item>
        <item row="3" column="0"><widget class="QLabel" name="shadowSplit2Label"><property name="text"><string>分割 2 (%)</string></property><property name="toolTip"><string>相机近裁剪面到有效阴影远端的百分比。分割须在 0% 到 100% 之间且从近到远严格递增。</string></property></widget></item>
        <item row="3" column="1"><widget class="QLineEdit" name="shadowSplit2Edit"><property name="accessibleName"><string>第二级联结束百分比</string></property></widget></item>
        <item row="4" column="0"><widget class="QLabel" name="shadowSplit3Label"><property name="text"><string>分割 3 (%)</string></property><property name="toolTip"><string>相机近裁剪面到有效阴影远端的百分比。分割须在 0% 到 100% 之间且从近到远严格递增。</string></property></widget></item>
        <item row="4" column="1"><widget class="QLineEdit" name="shadowSplit3Edit"><property name="accessibleName"><string>第三级联结束百分比</string></property></widget></item>
        <item row="5" column="0"><widget class="QLabel" name="shadowFadeStartLabel"><property name="text"><string>淡出起点 (%)</string></property><property name="toolTip"><string>相机深度达到有效最大阴影距离的这个百分比后开始淡出。100% 表示在远端直接截止。</string></property></widget></item>
        <item row="5" column="1"><widget class="QLineEdit" name="shadowFadeStartEdit"><property name="accessibleName"><string>阴影淡出起点百分比</string></property></widget></item>
        <item row="6" column="0"><widget class="QLabel" name="shadowFilterQualityLabel"><property name="text"><string>软阴影质量</string></property></widget></item>
        <item row="6" column="1"><widget class="QComboBox" name="shadowFilterQualityCombo">
         <property name="toolTip"><string>更高质量会平滑更宽的阴影边缘，并增加 GPU 采样开销。如果切到高档后表面出现自阴影条纹，可调整深度偏移和法线偏移。</string></property>
         <item><property name="text"><string>低（4 次采样）</string></property></item>
         <item><property name="text"><string>中（9 次采样）</string></property></item>
         <item><property name="text"><string>高（25 次采样）</string></property></item>
        </widget></item>
        <item row="7" column="0" colspan="2"><widget class="QPushButton" name="rebuildShadowsButton">
         <property name="text"><string>重建阴影一次</string></property>
         <property name="toolTip"><string>在使用此方向光的视口下一次绘制时重建阴影图。</string></property>
        </widget></item>
      </layout>
     </widget></item>
    </layout>
   </widget></item>
  </layout>
 </widget>
