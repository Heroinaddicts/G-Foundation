<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ResourceFieldForm</class>
 <widget class="QWidget" name="ResourceFieldForm">
  <property name="acceptDrops"><bool>true</bool></property>
  <property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Maximum"><horstretch>1</horstretch><verstretch>0</verstretch></sizepolicy></property>
  <property name="styleSheet"><string notr="true">QLineEdit#resourceNameEdit { background:#1d1f23; color:#e0e2e6; border:1px solid #454a53; border-radius:2px; padding:0px 5px; }
QLineEdit#resourceNameEdit:focus { border-color:#7fa8d2; }
QLineEdit#resourceNameEdit:disabled { color:#89919c; background:#24262a; }
QLabel#resourceTypeLabel { color:#b8c7d8; }
QLabel#resourceErrorLabel { color:#ffb4ae; }
QToolButton#selectResourceButton,QToolButton#resourceMenuButton { background:#30343a; color:#e0e2e6; border:1px solid #454a53; border-radius:2px; padding:0px; }
QToolButton#selectResourceButton:hover,QToolButton#resourceMenuButton:hover { background:#3c444f; border-color:#697586; }
QToolButton#selectResourceButton:focus,QToolButton#resourceMenuButton:focus { border-color:#7fa8d2; }
QToolButton#selectResourceButton:pressed,QToolButton#resourceMenuButton:pressed { background:#415974; }
QToolButton#selectResourceButton:disabled,QToolButton#resourceMenuButton:disabled { background:#292c31; border-color:#383c43; }
QToolButton#resourceMenuButton::menu-indicator { image:none; width:0px; }
QMenu#resourceMenu { background:#282c32; color:#e0e2e6; border:1px solid #566171; padding:4px 0; }
QMenu#resourceMenu::item { padding:5px 16px; }
QMenu#resourceMenu::item:selected { background:#3a526d; color:#ffffff; }
QMenu#resourceMenu::item:disabled { color:#89919c; }
QMenu#resourceMenu::separator { height:1px; background:#454a53; margin:4px 8px; }</string></property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing"><number>2</number></property>
   <property name="leftMargin"><number>0</number></property><property name="topMargin"><number>0</number></property><property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property>
   <item><widget class="QLabel" name="resourceTypeLabel"><property name="visible"><bool>false</bool></property><property name="text"><string>Resource</string></property><property name="textFormat"><enum>Qt::PlainText</enum></property><property name="wordWrap"><bool>true</bool></property></widget></item>
