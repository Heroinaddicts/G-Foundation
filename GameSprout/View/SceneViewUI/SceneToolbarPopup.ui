  <property name="styleSheet">
   <string>QWidget#SceneToolbarPopup { background:#292e36; color:#dce2e9; border:1px solid #5c6878; }
QCheckBox { color:#dce2e9; spacing:6px; font-size:12px; }
QPushButton { color:#dce2e9; background:transparent; border:1px solid transparent; border-radius:3px; padding:2px 6px; text-align:left; font-size:12px; }
QPushButton:hover,QPushButton:focus { background:#414750; border-color:#626b77; }
QPushButton:disabled,QCheckBox:disabled { color:#76808b; }</string>
