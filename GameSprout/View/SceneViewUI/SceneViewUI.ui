QToolButton { color:#edf3fb; background:#35465c; border:1px solid #667d99; border-radius:3px; padding:4px 8px; } QToolButton:hover { background:#435e80; }
QToolButton:checked { color:#fff7cb; background:#50688b; border-color:#d7b95a; }
