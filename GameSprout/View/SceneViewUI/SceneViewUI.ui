  <property name="styleSheet">
   <string>QWidget#SceneViewUIWindow,QWidget#sceneViewport { background:#202329; color:#dce2e9; }
QScrollArea#toolScrollArea,QWidget#toolContents { background:#292c32; border:0; }
QToolButton { color:#dce2e9; background:transparent; border:1px solid transparent; border-radius:3px; padding:0; }
QToolButton:hover { background:#414750; border-color:#626b77; }
QToolButton:checked { background:#3a6588; border-color:#74a4cd; }
QToolButton:disabled { color:#76808b; }
QComboBox { color:#dce2e9; background:#353a42; border:1px solid #505761; border-radius:2px; padding:1px 4px; font-size:12px; }
QComboBox QAbstractItemView { color:#dce2e9; background:#30343b; selection-background-color:#42688b; }
QCheckBox { color:#dce2e9; spacing:3px; font-size:12px; }
QCheckBox::indicator { width:12px; height:12px; border:1px solid #718095; border-radius:2px; background:#24282e; }
QCheckBox::indicator:checked { background:#578fc1; border-color:#a7c9e7; }
QScrollBar:horizontal { background:#292e36; height:10px; margin:0; }
QScrollBar::handle:horizontal { background:#5d697a; min-width:20px; border-radius:3px; }
QScrollBar::add-line:horizontal,QScrollBar::sub-line:horizontal { width:0; }
QScrollBar::add-page:horizontal,QScrollBar::sub-page:horizontal { background:transparent; }</string>
  </property>
