    <property name="styleSheet">
      <string>QWidget#InspectorUIWindow,QWidget#propertyBody,QWidget#TextureInspectorForm,QWidget#AssetInfoInspectorForm,QWidget#GameObjectInspectorForm,QWidget#componentHost,QWidget#scenePage,QWidget#sceneHost { background:#25272b; color:#e0e2e6; }
QLabel,QCheckBox,QGroupBox { color:#e0e2e6; }
QLabel#assetNameLabel { font-size:16px; font-weight:bold; }
QLabel#typeLabel,QLabel#stateLabel { color:#b8c7d8; }
QLabel#messageLabel { background:#3d3525; color:#f2d89b; border-radius:3px; padding:7px; }
QLabel#emptyLabel { color:#aab2bf; }
QLineEdit,QComboBox,QTreeWidget,QDoubleSpinBox,QSpinBox,QPlainTextEdit { background:#1d1f23; color:#e0e2e6; border:1px solid #454a53; border-radius:3px; padding:4px; }
QComboBox QAbstractItemView { background:#25272b; color:#e0e2e6; selection-background-color:#3a526d; }
QLineEdit:focus,QComboBox:focus { border-color:#7fa8d2; }
QPushButton,QToolButton { background:#3a4d63; color:#f1f4f8; border:1px solid #64788f; border-radius:3px; padding:5px 12px; }
QPushButton:disabled { color:#858b95; background:#30343a; border-color:#454a53; }
QToolButton:checked { background:#496c91; }
QGroupBox { border:1px solid #454a53; border-radius:3px; margin-top:10px; padding-top:8px; }
QGroupBox::title { subcontrol-origin:margin; padding:0 5px; }
QHeaderView::section { background:#30343a; color:#cbd0d8; border:0; padding:5px; }
QTreeWidget::item { min-height:22px; }
QScrollArea { border:0; background:#25272b; }
QScrollBar:vertical { background:#25272b; width:12px; margin:0; }
QScrollBar::handle:vertical { background:#555e6b; min-height:24px; border-radius:3px; }
QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical { height:0; }
QScrollBar::add-page:vertical,QScrollBar::sub-page:vertical { background:#25272b; }
QLineEdit:disabled,QComboBox:disabled,QDoubleSpinBox:disabled,QSpinBox:disabled,QPlainTextEdit:disabled { color:#89919c; background:#24262a; border-color:#383c43; }
QTabWidget::pane { border:1px solid #454a53; background:#25272b; }
QTabBar::tab { color:#bdc5d0; background:#30343a; padding:7px 10px; }
QTabBar::tab:selected { color:#ffffff; background:#3a526d; }</string>
