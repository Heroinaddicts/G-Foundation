  <property name="styleSheet">
   <string notr="true">
QMainWindow, QWidget#CentralWidget {
    background-color: #10151f;
}
QWidget {
    color: #e3e9f3;
    font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Noto Sans CJK SC&quot;, sans-serif;
    font-size: 14px;
}
QLabel { background: transparent; border: none; }
QFrame#FrameThinking, QFrame#FrameChat {
    background-color: #18202e;
    border: 1px solid #2b3649;
    border-radius: 14px;
}
QFrame#HeaderThinking, QFrame#HeaderChat {
    background: transparent;
    border: none;
    border-bottom: 1px solid #2b3649;
}
QLabel#LabelAgentAvatar {
    background-color: #244171;
    color: #c9ddff;
    border: 1px solid #3a5e93;
    border-radius: 12px;
    font-size: 17px;
    font-weight: 600;
}
QLabel#LabelAgentTitle {
    color: #f1f5fc;
    font-size: 17px;
    font-weight: 600;
}
QLabel#LabelThinkingTitle {
    color: #f1f5fc;
    font-size: 15px;
    font-weight: 600;
}
QLabel#LabelThinkingSubtitle, QLabel#LabelModel,
QLabel#LabelInputHint, QLabel#LabelThinkingHint {
    color: #8f9db4;
    font-size: 12px;
}
QLabel#LabelThinkingState {
    color: #bcacef;
    background-color: #29243e;
    border: 1px solid #41375a;
    border-radius: 9px;
    padding: 4px 9px;
    font-size: 11px;
}
QLabel#LabelChatState {
    color: #91b7ff;
    background-color: #202f48;
    border: 1px solid #344b70;
    border-radius: 9px;
    padding: 4px 10px;
    font-size: 12px;
}
QFrame#FrameThinkingBody, QFrame#FrameOutput {
    background: transparent;
    border: none;
}
QPlainTextEdit#TextThinking, QTextBrowser#TextOutput {
    background-color: #18202e;
    border: none;
    padding: 4px;
    selection-background-color: #365d94;
    selection-color: #ffffff;
}
QPlainTextEdit#TextThinking {
    color: #b4c0d4;
    font-size: 13px;
}
QFrame#FrameInput {
    background-color: #1c2636;
    border: none;
    border-top: 1px solid #303d52;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}
QLabel#LabelInputTitle {
    color: #c3cee0;
    font-size: 12px;
    font-weight: 600;
}
QPlainTextEdit#EditMessage {
    color: #edf3ff;
    background-color: #151e2b;
    border: 1px solid #33435b;
    border-radius: 9px;
    padding: 8px;
    selection-background-color: #365d94;
    selection-color: #ffffff;
}
QPlainTextEdit#EditMessage:focus { border: 1px solid #688fff; }
QPushButton#BtnSend {
    color: #ffffff;
    background-color: #527ff0;
    border: 1px solid #6a92fa;
    border-radius: 9px;
    padding: 7px 22px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#BtnSend:hover { background-color: #638efb; }
QPushButton#BtnSend:pressed { background-color: #426bd0; }
QPushButton#BtnSend:focus { border: 1px solid #b5ccff; }
QPushButton#BtnSend:disabled {
    color: #8493ac;
    background-color: #2c3b56;
    border-color: #394b69;
}
QSplitter#SplitterMain::handle {
    background-color: #10151f;
}
QSplitter#SplitterMain::handle:hover {
    background-color: #3b5376;
    border-radius: 3px;
}
QSplitter#SplitterConversation::handle {
    background-color: #263247;
}
QSplitter#SplitterConversation::handle:hover {
    background-color: #6487c6;
}
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 0;
}
QScrollBar::handle:vertical {
    background-color: #3b4b64;
    min-height: 28px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover { background-color: #536b90; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QToolTip {
    color: #e3e9f3;
    background-color: #222e42;
    border: 1px solid #435774;
    padding: 5px;
}
